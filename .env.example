# Dev only: where the dev server forwards /api requests. Leave VITE_API_BASE_URL
# empty locally so the browser calls same-origin /api and hits this proxy.
VITE_API_TARGET=http://localhost:8080

# Production only: absolute origin of the deployed API, e.g. https://api.example.com
# CI supplies this from the WAREHOUSE_API_URL repository variable, and the build
# fails if it is missing.
VITE_API_BASE_URL=
